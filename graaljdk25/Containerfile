# ╚████╔╝ ██║  ██║██║ ╚████║███████╗███████║     ██║██████╔╝╚██████╔╝
#  ╚═══╝  ╚═╝  ╚═╝╚═╝  ╚═══╝╚══════╝╚══════╝     ╚═╝╚═════╝  ╚═════╝ 
# Pterodactyl Image created by vanes430
# syntax=docker/dockerfile:1.5
FROM --platform=$TARGETOS/$TARGETARCH rockylinux:9-minimal

LABEL author="vanes430" \
      maintainer="admin@vanes430.my.id" \
      org.opencontainers.image.source="https://github.com/vanes430/protection" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.description="Pterodactyl Image created by vanes430"

RUN microdnf install -y \
        wget \
        ca-certificates \
        openssl \
        passwd \
        tar \
        glibc-langpack-en \
        shadow-utils \
    && microdnf clean all

ARG TARGETARCH
ARG GRAAL_VERSION=25

RUN case "${TARGETARCH}" in \
        amd64)  GRAAL_ARCH="x64" ;; \
        arm64)  GRAAL_ARCH="aarch64" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" && exit 1 ;; \
    esac \
    && wget -O /tmp/graalvm.tar.gz "https://download.oracle.com/graalvm/${GRAAL_VERSION}/latest/graalvm-jdk-${GRAAL_VERSION}_linux-${GRAAL_ARCH}_bin.tar.gz" \
    && mkdir -p /opt/graalvm \
    && tar -xzf /tmp/graalvm.tar.gz --strip-components=1 -C /opt/graalvm \
    && rm /tmp/graalvm.tar.gz

RUN useradd -m -d /home/container container

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8
ENV JAVA_HOME=/opt/graalvm
ENV PATH=/opt/graalvm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

USER container
ENV USER="container" \
    HOME="/home/container"
WORKDIR /home/container

COPY ../entrypoint /entrypoint

ENTRYPOINT ["/entrypoint"]
